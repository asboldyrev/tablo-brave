{
  "manifest_version": 3,
  "name": "Табло для Brave",
  "description": "Крупные плитки и всплывающие папки на новой вкладке. Все сайты хранятся в обычных закладках.",
  "version": "0.4.0",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "search",
    "tabs"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
